# AI Provider API Keys (set the one matching your config.yaml ai.provider)
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AI...
OPENAI_API_KEY=sk-...
# OpenCode Go — get key at https://opencode.ai/auth (docs: https://opencode.ai/docs/go/)
OPENCODE_GO_API_KEY=...

# Site credentials (referenced in config.yaml via ${VAR_NAME})
# DASHBOARD_USER=your-username
# DASHBOARD_PASS=your-password
